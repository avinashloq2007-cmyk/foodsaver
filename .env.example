# Production defaults. Copy to .env and supply your own credentials.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
# Behind one trusted HTTPS reverse proxy, use TRUST_PROXY=1 and an https APP_ORIGIN.
TRUST_PROXY=0
DB_DRIVER=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=foodsaver
MYSQL_USER=foodsaver
MYSQL_PASSWORD=replace-me
# 32+ random characters, kept only on the server.
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
DEMO_MODE=false
SEED_DEMO=false
# Firebase Admin service account outside the project (never commit it).
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/service-account.json
FIREBASE_PROJECT_ID=
# Public Firebase web-app config (not private Admin credentials).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
# Admin requires verified phone OTP + this independent TOTP factor.
# Generate an authenticator secret with: node scripts/admin-secret.js
ADMIN_TOTP_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
